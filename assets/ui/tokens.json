{
  "$schema": "choseway-style design tokens v1 — 平台无关的设计 token，所有平台移植都应从这里取值，不要各自手抄",
  "meta": { "name": "ChoseWay / 千往 红黑赛博科技风", "source": "AI_ChoseWayManager/web/src/styles.css", "version": "1.0.0", "date": "2026-08-23" },

  "color": {
    "bg":           { "hex": "#070707", "rgba": [7, 7, 7, 1.0],           "use": "页面 / 窗口底色" },
    "bgGradTop":    { "hex": "#0B0B0B", "use": "竖向底渐变 0%" },
    "bgGradMid":    { "hex": "#111111", "use": "竖向底渐变 45%" },
    "bgGradBottom": { "hex": "#060606", "use": "竖向底渐变 100%" },
    "panelSolid":   { "hex": "#121212", "rgba": [18, 18, 18, 0.94],       "use": "实底浮层（菜单 / 弹窗 / 表头）" },
    "panelSolid2":  { "hex": "#0E0E0E", "rgba": [14, 14, 14, 0.96],       "use": "弹窗 / toast 实底" },
    "panelSoft":    { "rgba": [255, 255, 255, 0.035],                     "use": "标签 / 空态 / 次级块底" },
    "card":         { "rgba": [255, 255, 255, 0.04],                      "use": "默认按钮 / 卡片底；玻璃面板渐变起点" },
    "cardEnd":      { "rgba": [255, 255, 255, 0.018],                     "use": "玻璃面板渐变终点" },
    "cardHover":    { "rgba": [255, 255, 255, 0.07],                      "use": "悬停底" },
    "line":         { "rgba": [255, 255, 255, 0.09],                      "use": "默认描边" },
    "lineSoft":     { "rgba": [255, 255, 255, 0.07],                      "use": "分隔线" },
    "lineStrong":   { "rgba": [255, 255, 255, 0.16],                      "use": "悬停 / 激活描边" },
    "inputBg":      { "rgba": [0, 0, 0, 0.2],                             "use": "输入框 / 分段控件外壳底" },
    "text":         { "hex": "#F4EFE9",                                   "use": "正文（暖白）" },
    "muted":        { "hex": "#B9AEA4",                                   "use": "次要文字" },
    "faint":        { "rgba": [255, 255, 255, 0.42],                      "use": "辅助 / 占位 / 表头" },
    "eyebrow":      { "rgba": [255, 255, 255, 0.62],                      "use": "面板眉标" },
    "white":        { "hex": "#FFFFFF",                                   "use": "仅主按钮文字 / 激活导航 / 弹窗强调" },
    "red":          { "hex": "#D4121F",                                   "use": "品牌红：渐变起点、复选框、置顶左条" },
    "redBright":    { "hex": "#FF3748",                                   "use": "亮红：渐变终点、逾期、错误、今天线" },
    "redDim":       { "rgba": [212, 18, 31, 0.14],                        "use": "选区底、危险按钮底" },
    "redFill":      { "rgba": [212, 18, 31, 0.16],                        "use": "红胶囊 / 选中项底（.16~.18）" },
    "redBorder":    { "rgba": [255, 82, 95, 0.40],                        "use": "焦点环 / 拖拽描边 / 红胶囊描边" },
    "redBorderSoft":{ "rgba": [255, 82, 95, 0.22],                        "use": "红标签描边" },
    "redText":      { "hex": "#FFB3BA",                                   "use": "红底上的文字（不要用纯红写字）" },
    "redGlow":      { "rgba": [255, 55, 72, 0.45],                        "use": "红色辉光 / 描边数字" },
    "redShadow":    { "rgba": [212, 18, 31, 0.28],                        "use": "主按钮 / Logo 投影" },
    "gold":         { "hex": "#E8B54A",                                   "use": "仅重要；渐变到 goldDeep" },
    "goldDeep":     { "hex": "#C9902E" },
    "goldText":     { "hex": "#FFD98A" },
    "goldFill":     { "rgba": [232, 181, 74, 0.13] },
    "goldBorder":   { "rgba": [232, 181, 74, 0.42] },
    "warn":         { "hex": "#D9A13B",                                   "use": "临期 / 警告 / 低库存 / 重连中" },
    "orange":       { "hex": "#FF8C3B",                                   "use": "仅紧急；渐变到 orangeDeep" },
    "orangeDeep":   { "hex": "#D9720E" },
    "ok":           { "hex": "#46C576",                                   "use": "在线 / 成功 / 完成态" },
    "link":         { "hex": "#7FA0DC",                                   "use": "仅「关联 / 跳转」小标签" },
    "neutralBar":   { "rgba": [255, 255, 255, 0.22],                      "use": "普通优先级色条" },
    "neutralDeep":  { "hex": "#4A443F",                                   "use": "甘特普通色块" },
    "male":         { "hex": "#7FB4FF" },
    "female":       { "hex": "#FF9CCC" },
    "keycap":       { "hex": "#1D1D1D" },
    "categoryHash": ["#FF6B6B", "#D9A13B", "#46C576", "#4FA3D9", "#9A7BD9", "#D96BB1", "#4FC2BD", "#C9B458"]
  },

  "gradient": {
    "redPrimary":   { "angle": 135, "stops": ["#D4121F", "#FF3748"],                               "use": "主按钮 / Logo / 头像兜底 / 滑杆把手" },
    "glass":        { "angle": 180, "stops": ["rgba(255,255,255,.04)", "rgba(255,255,255,.018)"],    "use": "面板 / 侧栏 / 卡片（叠在透明或 panelSolid 上）" },
    "navActive":    { "angle": 135, "stops": ["rgba(212,18,31,.28)", "rgba(255,255,255,.06)"],     "use": "导航激活态" },
    "iconBox":      { "angle": 135, "stops": ["rgba(212,18,31,.24)", "rgba(255,255,255,.05)"],     "use": "图标块 / 本人块" },
    "cornerTint":   { "angle": 135, "stops": ["rgba(212,18,31,.11)", "transparent 26%"],           "use": "登录卡左上红晕" },
    "pinned":       { "angle": 90,  "stops": ["rgba(212,18,31,.07)", "transparent 70%"],           "use": "置顶条目" },
    "bodyRadialTL": { "type": "radial", "at": "0% 0%",   "stops": ["rgba(212,18,31,.22)", "transparent 24%"] },
    "bodyRadialTR": { "type": "radial", "at": "100% 0%", "stops": ["rgba(255,255,255,.06)", "transparent 16%"] }
  },

  "radius": { "xl": 28, "lg": 22, "md": 18, "card": 14, "sm": 12, "item": 9, "tiny": 7, "pill": 999,
    "note": "xl 侧栏/登录卡/弹窗；lg 面板/看板列；md 行卡；card 任务卡/输入框/导航项/菜单；sm 图标块；item 菜单项；tiny icon-btn/键帽；pill 按钮/标签/胶囊" },

  "border": { "width": 1, "default": "line", "hover": "lineStrong", "focusRing": { "color": "redBorder", "halo": "rgba(212,18,31,.16) 3px" } },

  "shadow": {
    "card":   "0 18px 40px rgba(0,0,0,.28)",
    "float":  "0 24px 60px rgba(0,0,0,.55)",
    "modal":  "0 30px 90px rgba(0,0,0,.52)",
    "primary":"0 14px 28px rgba(212,18,31,.28)",
    "logo":   "0 10px 22px rgba(212,18,31,.28)",
    "glowDot":"0 0 8px <同色 .5~.7>"
  },

  "blur": { "panel": 12, "float": 14, "modalMask": 8, "drawerMask": 3, "note": "无 backdrop 能力的平台改用 panelSolid 实底" },

  "grid": { "size": 34, "lineAlphaV": 0.025, "lineAlphaH": 0.018, "fadeTo": "92%", "note": "全屏细网格向下渐隐；无能力的平台可省略" },

  "typography": {
    "family":     ["Segoe UI", "PingFang SC", "Microsoft YaHei", "微软雅黑", "system-ui", "sans-serif"],
    "familyNum":  ["Bahnschrift", "DIN Alternate", "Arial Narrow", "Segoe UI"],
    "familyMono": ["Consolas", "Monaco", "ui-monospace", "monospace"],
    "base": 14, "lineHeight": 1.6,
    "scale": { "pageTitle": 26, "modalTitle": 18, "cardTitle": 14.5, "body": 13, "secondary": 12.5, "caption": 11.5, "badge": 10.5, "eyebrow": 12, "logoSub": 10.5, "bigNum": 46, "bigNumEdit": 34 },
    "weight": { "title": 700, "button": 700, "label": 600, "body": 400 },
    "tracking": { "pageTitle": "-0.03em", "modalTitle": "-0.02em", "eyebrow": "0.08em", "tableHead": "0.06em", "logoSub": "0.14em", "bigNum": "-0.04em" },
    "eyebrow": { "size": 12, "weight": 700, "uppercase": true, "color": "eyebrow" },
    "bigNum":  { "italic": true, "weight": 700, "tabular": true, "stroke": "1.5px redGlow（装饰态）或实色 redText（编辑态）" }
  },

  "size": { "button": 38, "buttonSm": 30, "input": 38, "navItem": 40, "tag": 26, "tagSm": 21, "chip": 28, "segBtn": 30, "iconBtn": 26, "iconBox": 44, "logoMark": 34, "statusDot": 8, "quadBar": 3, "quadCell": 8, "keycap": [34, 30], "sidebar": 224, "shellPad": 14, "gap": 14, "dashRow": 88, "dashCols": 12 },

  "motion": {
    "fast": "0.15s", "card": "180ms ease", "dash": "0.16s ease", "progress": "0.45s cubic-bezier(.3,.9,.3,1)",
    "popIn": { "name": "dd-in", "dur": "0.12s", "from": "opacity 0, translateY -4px" },
    "fxSpeed": "1.8s", "fxGlow": 1,
    "breath": "quad-breath：整卡红晕 .14↔.52",
    "bar":    "quad-bar：色条 opacity .4↔1 + 辉光",
    "pulse":  "quad-pulse：opacity .4↔1",
    "flow":   "prog-flow：斜纹位移 23px / 4.2s linear",
    "flash":  "focus-flash：1.3s × 2，红环 2px + 22px 辉光",
    "todayLine": "3s 呼吸辉光",
    "reducedMotion": "全部无限动画关闭，改静态描边"
  },

  "semantic": {
    "overdue": "redBright", "soon": "warn", "ok": "ok", "unknown": "faint",
    "quadrant": { "urgentImportant": "red(+breath)", "important": "gold", "urgent": "orange(+pulse)", "normal": "neutral(+dim .68)" },
    "confidence": { "high": "ok", "mid": "warn(输入框黄底)", "low": "faint(虚线框)" },
    "sourceBadges": { "task": "📋", "project": "📽", "vault": "🔐", "hr": "👥", "system": "⚡", "announcement": "📢", "reminder": "📌" }
  },

  "zIndex": { "shell": 1, "dashDrag": 50, "mobileTopbar": 60, "ganttHead": 30, "modal": 100, "drawer": 101, "toast": 200, "lightbox": 260, "dropdown": 300, "contextMenu": 400, "dragGhost": 500, "dialog": 600, "intro": 1000 },

  "breakpoints": { "mobile": 768, "homeSingleCol": 1100, "settingsSingleCol": 1000, "peekShrink": 1400 }
}
